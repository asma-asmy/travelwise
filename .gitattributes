# Default: normalize all text files to LF in the repository
* text=auto eol=lf

# Windows-specific files should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - never convert line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.apk binary

# Lockfiles - leave alone; package managers handle them
package-lock.json -text 